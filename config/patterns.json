        },
        {
          "id": "IGN-010",
          "file_pattern": "**/external/old_lib/**",
          "issue_pattern": "error: .*C\\+\\+11.*",
          "reason": "旧库不支持C++11，但功能正常",
          "severity": "high",
          "category": "external_dependency",
          "created": "2024-01-15",
          "expires": "2024-06-30",
          "review_frequency": "monthly",
          "active": true
        }
      ],
      
      "categories": {
        "third_party": "第三方库问题",
        "platform_specific": "平台特定问题",
        "generated_code": "生成代码问题",
        "style": "代码风格问题",
        "info": "信息性提示",
        "test_code": "测试代码问题",
        "legacy_code": "遗留代码问题",
        "refactoring": "重构期间的问题",
        "external_dependency": "外部依赖问题",
        "language_specific": "语言特定问题"
      },
      
      "validation": {
        "require_id": true,
        "require_reason": true,
        "require_author": true,
        "allow_temporary": true,
        "max_expiry_days": 365,
        "auto_deactivate_expired": true,
        "require_review": true,
        "default_review_frequency": "quarterly"
      },
      
      "management": {
        "auto_suggest_rules": true,
        "suggest_threshold": 5,
        "archive_inactive_rules": true,
        "max_rules_per_category": 50,
        "notification_on_expiry": true
      }
    },
    
    "smart_ignore_suggestions": {
      "description": "基于统计的智能忽略建议规则",
      
      "rules": [
        {
          "condition": {
            "file_pattern": "**/*",
            "issue_pattern": "warning: .*unused.*parameter.*",
            "min_occurrences": 10,
            "max_severity": "medium",
            "time_window_days": 30
          },
          "suggestion": {
            "action": "suggest_ignore",
            "reason": "频繁出现的未使用参数警告",
            "confidence": 0.8,
            "alternative": "考虑使用[[maybe_unused]]或(void)parameter",
            "template": {
              "file_pattern": "${file_pattern}",
              "issue_pattern": "${issue_pattern}",
              "reason": "${reason}",
              "severity": "medium",
              "category": "style"
            }
          }
        },
        {
          "condition": {
            "file_pattern": "**/third_party/**",
            "issue_pattern": ".*",
            "min_occurrences": 3,
            "time_window_days": 7
          },
          "suggestion": {
            "action": "auto_ignore",
            "reason": "第三方库问题",
            "confidence": 0.95,
            "template": {
              "file_pattern": "${file_pattern}",
              "issue_pattern": "${issue_pattern}",
              "reason": "第三方库代码，不检查",
              "severity": "all",
              "category": "third_party"
            }
          }
        },
        {
          "condition": {
            "file_pattern": "**/generated/**",
            "issue_pattern": "warning: .*",
            "min_occurrences": 5,
            "time_window_days": 14
          },
          "suggestion": {
            "action": "suggest_ignore",
            "reason": "生成代码中的警告",
            "confidence": 0.7,
            "alternative": "检查生成工具配置",
            "template": {
              "file_pattern": "${file_pattern}",
              "issue_pattern": "${issue_pattern}",
              "reason": "生成代码警告",
              "severity": "low",
              "category": "generated_code"
            }
          }
        }
      ],
      
      "enabled": true,
      "min_confidence": 0.6,
      "auto_apply": false,
      "require_approval": true,
      "notification_channel": "code-review"
    },
    
    "report_config": {
      "description": "报告生成配置",
      
      "general": {
        "max_issues_per_report": 1000,
        "truncate_long_messages": true,
        "max_message_length": 500,
        "include_code_snippet": true,
        "max_snippet_lines": 5,
        "include_ignored_summary": true,
        "include_config_summary": true,
        "timestamp_format": "%Y-%m-%d %H:%M:%S",
        "timezone": "UTC"
      },
      
      "grouping": {
        "group_by": ["file", "severity", "category"],
        "sort_by": ["severity", "confidence", "file"],
        "sort_order": "desc",
        "collapse_groups": true,
        "max_items_per_group": 50
      },
      
      "export": {
        "formats": ["json", "html", "markdown", "csv"],
        "default_format": "html",
        "compression": true,
        "split_large_reports": true,
        "max_file_size_mb": 10
      },
      
      "charts": {
        "enabled": true,
        "types": ["pie", "bar", "trend", "sunburst"],
        "show_severity_distribution": true,
        "show_pattern_distribution": true,
        "show_category_distribution": true,
        "show_trend_over_time": true,
        "chart_colors": {
          "critical": "#d32f2f",
          "high": "#f57c00",
          "medium": "#fbc02d",
          "low": "#388e3c"
        }
      },
      
      "notifications": {
        "enabled": true,
        "channels": ["email", "slack", "teams"],
        "thresholds": {
          "critical": 1,
          "high": 3,
          "medium": 10,
          "low": 50
        },
        "recipients": ["dev-team@company.com", "qa-team@company.com"],
        "frequency": "immediate"
      },
      
      "templates": {
        "html": "templates/report.html.j2",
        "markdown": "templates/report.md.j2",
        "email": "templates/email.html.j2"
      }
    },
    
    "performance": {
      "description": "性能优化配置",
      
      "parsing": {
        "max_concurrent_parsers": 4,
        "chunk_size_lines": 1000,
        "stream_parsing": true,
        "early_exit_on_fatal": false
      },
      
      "caching": {
        "enabled": true,
        "cache_ttl_seconds": 3600,
        "max_cache_size_mb": 1000,
        "cache_dir": "${workspace}/.cache/compile-analyzer",
        "compress_cache": true
      },
      
      "limits": {
        "max_log_file_size_mb": 100,
        "max_issues_per_file": 10000,
        "max_files_to_process": 1000,
        "timeout_seconds": 300
      },
      
      "memory": {
        "max_memory_mb": 2048,
        "gc_threshold": 0.8,
        "buffer_size_kb": 4096
      }
    },
    
    "validation": {
      "description": "配置验证规则",
      
      "schema": {
        "enforce_schema": true,
        "schema_version": "1.1",
        "allow_unknown_fields": false,
        "strict_mode": false
      },
      
      "patterns": {
        "check_pattern_validity": true,
        "test_patterns_on_load": true,
        "warn_on_invalid_pattern": true,
        "max_pattern_test_samples": 10
      },
      
      "files": {
        "check_file_existence": false,
        "resolve_paths": true,
        "warn_on_missing_files": true
      },
      
      "logging": {
        "level": "INFO",
        "format": "json",
        "output": "file",
        "log_file": "${workspace}/logs/config-validator.log",
        "max_log_size_mb": 10
      }
    },
    
    "debug": {
      "description": "调试和开发配置",
      
      "logging": {
        "enabled": false,
        "level": "DEBUG",
        "log_pattern_matching": false,
        "log_ignore_decisions": false,
        "log_performance": false
      },
      
      "profiling": {
        "enabled": false,
        "profile_pattern_matching": false,
        "profile_file_io": false,
        "output_dir": "${workspace}/profiling"
      },
      
      "testing": {
        "test_patterns": true,
        "test_files": [
          "samples/compile_errors.log",
          "samples/compile_warnings.log"
        ],
        "expected_results": "samples/expected_results.json"
      },
      
      "development": {
        "hot_reload": true,
        "watch_config_changes": true,
        "auto_test_on_change": true,
        "notify_on_error": true
      }
    },
    
    "integrations": {
      "description": "外部系统集成配置",
      
      "version_control": {
        "git": {
          "enabled": true,
          "blame_enabled": true,
          "diff_context_lines": 3,
          "include_commit_messages": true
        },
        "svn": {
          "enabled": false
        }
      },
      
      "ci_cd": {
        "jenkins": {
          "enabled": true,
          "job_name_pattern": ".*",
          "build_parameters": ["BRANCH", "TARGET"]
        },
        "gitlab": {
          "enabled": true,
          "merge_request_analysis": true,
          "auto_comment": true
        },
        "github": {
          "enabled": true,
          "pull_request_analysis": true,
          "status_checks": true
        }
      },
      
      "issue_tracking": {
        "jira": {
          "enabled": false,
          "project_key": "DEV",
          "issue_type": "Bug"
        },
        "github_issues": {
          "enabled": true,
          "labels": ["compiler-warning", "static-analysis"]
        }
      },
      
      "communication": {
        "slack": {
          "enabled": true,
          "channel": "#code-quality",
          "webhook": "${SLACK_WEBHOOK_URL}"
        },
        "teams": {
          "enabled": false
        },
        "email": {
          "enabled": true,
          "smtp_server": "smtp.company.com",
          "from_address": "code-analyzer@company.com"
        }
      },
      
      "monitoring": {
        "prometheus": {
          "enabled": true,
          "port": 9091,
          "metrics_prefix": "compile_analyzer_"
        },
        "grafana": {
          "enabled": true,
          "dashboard_id": "compile-analysis"
        }
      }
    },
    
    "security": {
      "description": "安全相关配置",
      
      "authentication": {
        "require_auth": false,
        "auth_type": "jwt",
        "token_ttl_hours": 24
      },
      
      "authorization": {
        "role_based_access": true,
        "roles": {
          "admin": ["*"],
          "developer": ["read", "analyze"],
          "viewer": ["read"]
        }
      },
      
      "data_protection": {
        "mask_sensitive_data": true,
        "sensitive_patterns": [
          "password.*=.*",
          "api_key.*=.*",
          "token.*=.*"
        ],
        "encrypt_cache": false
      },
      
      "audit": {
        "log_access": true,
        "log_config_changes": true,
        "retention_days": 90
      }
    }
  }